# このファイルをコピーして各環境の .env を作る（環境依存値はリポジトリに置かない）。
#   - ローカル開発: nuxt/.env を pnpm dev が読む
#   - 本番: 転送先の ~/nuxt/.env を ecosystem.config.cjs が PM2 起動時に読み、実行時 env として渡す
# NUXT_PUBLIC_* はビルド時には焼き込まれず、node サーバ起動時に runtimeConfig を上書きする
# （SPA でもサーバが配信ペイロードへ注入）。.env 自体は転送せず各環境が保持する。
# 秘匿値は置かないこと（NUXT_PUBLIC_* はクライアントへ露出する公開値のみ）。

# 実行環境ラベル。空ならバッジを出さない（本番想定）。
NUXT_PUBLIC_ENV_LABEL=local
# Google SSO 用 OAuth クライアント ID（公開値）。nest 側の GOOGLE_CLIENT_ID と一致させる。
# ssr: false のためビルド時に埋め込まれる（dev/build 実行時に設定が必要）。
NUXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
